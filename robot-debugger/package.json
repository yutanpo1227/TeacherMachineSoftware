{
  "name": "robot-soccer-debugger",
  "version": "1.0.0",
  "private": true,
  "description": "ロボットサッカーのシリアルモニター",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:mac": "electron-builder --mac --dir",
    "postinstall": "electron-rebuild -f -w @serialport/bindings-cpp"
  },
  "build": {
    "appId": "org.rcj.pitchmonitor",
    "productName": "PITCH Robot Monitor",
    "files": ["main.js", "preload.js", "index.html", "style.css", "renderer.js", "telemetry.js"],
    "mac": { "category": "public.app-category.developer-tools", "identity": null }
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
